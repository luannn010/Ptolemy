# Ptolemy MCP server — example Codex CLI config block.
#
# Copy this [mcp_servers.ptolemy] section into your ~/.codex/config.toml.
# Codex spawns the binary locally over stdio, so:
#   - the `command` path must exist on the SAME machine Codex runs on, and
#   - the *_BASE_URL / DATABASE_URL values must be reachable from that machine.
#
# Memory tools (recall/capture/consolidate) run IN-PROCESS in ptolemy-mcp and
# talk straight to Postgres — they do not need workerd. WORKER_BASE_URL is only
# used by the session/executor tools (which proxy to the workerd HTTP API).
#
# If DATABASE_URL is unset, the memory tools are silently omitted and the rest
# of the MCP surface still works.

[mcp_servers.ptolemy]
command = "/opt/ptolemy/bin/ptolemy-mcp"
args = []

[mcp_servers.ptolemy.env]
# --- memory backend (required for recall/capture/consolidate) ---
DATABASE_URL       = "postgres://ptolemy:ptolemy@localhost:5432/ptolemy?sslmode=disable"
BRAIN_BASE_URL     = "http://127.0.0.1:8088"
BRAIN_MODEL        = "your-chat-model"
EMBEDDING_BASE_URL = "http://127.0.0.1:8000"
EMBEDDING_MODEL    = "bge-large-en-v1.5"
EMBEDDING_DIM      = "1024"

# --- default recall/capture scope (optional) ---
PTOLEMY_MEMORY_SUBJECT = "default"
PTOLEMY_MEMORY_PROJECT = "ptolemy"

# --- agentic RAG (recall with generate/trace routes through the agent loop) ---
AGENT_LOOP_ENABLED = "true"
AGENT_MAX_STEPS    = "5"

# --- only needed for session/executor tools (proxy to workerd) ---
WORKER_BASE_URL    = "http://127.0.0.1:8080"
