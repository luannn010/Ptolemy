{
  "rules": [
    {
      "id": "deny-policy-write",
      "contains": ".ptolemy/policy.json",
      "effect": "deny",
      "reason": "policy file is protected"
    },
    {
      "id": "deny-secret-cmd",
      "contains": ".env",
      "effect": "deny",
      "reason": "secret file access denied"
    },
    {
      "id": "deny-destructive",
      "contains": "git push --force",
      "effect": "deny",
      "reason": "force push denied"
    },
    {
      "id": "deny-destructive-rm",
      "contains": "rm -rf",
      "effect": "deny",
      "reason": "destructive deletion denied"
    },
    {
      "id": "ask-push-cmd",
      "contains": "git push",
      "effect": "ask",
      "channel": "oob",
      "reason": "git push requires confirmation"
    },
    {
      "id": "ask-network",
      "contains": "curl http",
      "effect": "ask",
      "channel": "oob",
      "reason": "network download requires confirmation"
    },
    {
      "id": "allow-build-test",
      "contains": "go test",
      "effect": "allow",
      "reason": "build/test command allowed"
    },
    {
      "id": "allow-brain-wake",
      "contains": "brain wake",
      "effect": "allow",
      "reason": "auto-wake / manual start of the local brain"
    },
    {
      "id": "allow-brain-status",
      "contains": "brain status",
      "effect": "allow",
      "reason": "brain status is a read"
    },
    {
      "id": "allow-brain-autounload",
      "contains": "brain autounload",
      "effect": "allow",
      "reason": "idle-TTL unload of the local brain"
    },
    {
      "id": "ask-brain-switch",
      "contains": "brain switch",
      "effect": "ask",
      "channel": "oob",
      "reason": "manual brain model switch requires confirmation"
    },
    {
      "id": "ask-brain-stop",
      "contains": "brain stop",
      "effect": "ask",
      "channel": "oob",
      "reason": "manual brain stop requires confirmation"
    }
  ]
}
