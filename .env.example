APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug
STATE_DIR=./state
DB_PATH=./state/ptolemy.db
WORKER_BASE_URL=http://127.0.0.1:8080
BRAIN_BASE_URL=http://127.0.0.1:8088
BRAIN_MODEL=gemma-4-e2b
POSTGRES_BASE_URL=http://localhost:1091
DATABASE_URL=postgres://ptolemy:ptolemy@localhost:5432/ptolemy?sslmode=disable
RAG_TOP_K=8
RAG_CHUNK_SIZE_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BASE_URL=http://localhost:8000
EMBEDDING_MODEL=bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
SMOKE_TEST_CHUNK_SIZE=50
# Phase 3 recency tuning. Defaults are the spec values (0.1 / 30d).
# Override via the sweep harness; production should usually leave unset.
RAG_RECENCY_WEIGHT=0.1
RAG_RECENCY_HALFLIFE_DAYS=30
# Phase 3 eval. When set, memory-eval ingests fixture markdown from this
# directory instead of the seed.json corpus list. Unset = legacy live-docs path.
RAG_FIXTURE_DIR=internal/memory/eval/testdata/corpus
# Phase 4 Memory GC. Defaults are PLACEHOLDERS — tune against real chat volume
# via Stats() once Phase 6 produces project rows. The sweep is opt-in and only
# runs in workerd when GC_SWEEP_ENABLED=true AND DATABASE_URL is set.
GC_SWEEP_ENABLED=false
GC_SWEEP_INTERVAL=1h
GC_DECAY_LAMBDA=0.05
GC_ARCHIVE_THRESHOLD=0.1
GC_PURGE_ENABLED=false
GC_PURGE_GRACE_DAYS=30
# Phase 5 dedup (placeholders — tune against real volume; gated off by default)
GC_DEDUP_ENABLED=false
GC_DEDUP_THRESHOLD=0.7
GC_DEDUP_LOOKBACK=24h
# Agentic RAG (rung 1). Default OFF: Orchestrator.Answer runs the legacy pipeline
# unless AGENT_LOOP_ENABLED=true, which delegates to the agent loop (planner +
# step budget + grounding gate). AGENT_MAX_STEPS hard-caps loop iterations
# (<=0 falls back to 5); budget exhaustion forces an honest give_up.
AGENT_LOOP_ENABLED=false
AGENT_MAX_STEPS=5
